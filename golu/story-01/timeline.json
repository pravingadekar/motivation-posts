   "dur": 10.731,
   "lines": [
    {
     "who": "haathi",
     "hi": "गोलू बेटा, आज बहुत गर्मी है। एक आम मिल जाए तो प्यास बुझ जाए।",
     "start": 0.6,
     "dur": 4.171,
     "file": "golu/story-01/voice/s08_l0.wav",
     "abs": 76.81
    },
    {
     "who": "golu",
     "hi": "नहीं दादा! सब मेरे हैं!",
     "start": 5.221,
     "dur": 1.175,
     "file": "golu/story-01/voice/s08_l1.wav",
     "abs": 81.431
    },
    {
     "who": "narrator",
     "hi": "हाथी दादा धीरे-धीरे पेड़ की छाँव में बैठ गए।",
     "start": 6.846,
     "dur": 3.085,
     "file": "golu/story-01/voice/s08_l2.wav",
     "abs": 83.056
    }
   ]
